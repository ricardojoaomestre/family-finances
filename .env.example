DATABASE_URL=postgresql://user:password@host/db?sslmode=require

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Bank aggregator (read-only account data; optional)
BANK_AGGREGATOR_PROVIDER=enable-banking
# Enable Banking production apps require HTTPS redirect URLs (http:// is rejected).
BANK_AGGREGATOR_REDIRECT_URL=https://localhost:3000/api/bank/callback
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=.enable-banking/private.pem
